# AiChat Training Data Pipeline — environment variables template.
#
# Copy to `.env` and fill in your keys. The loader searches these locations
# in order; first match wins (real environment variables always override .env):
#   1. ./.env                          (current working directory)
#   2. ~/.aichat/.env                  (user-level)
#   3. <server>/.env                   (next to this file)
#
# Lines starting with `#` are comments. Values may be quoted:
#   AICHAT_DEEPSEEK_KEY="sk-xxxx"
#   AICHAT_DEEPSEEK_KEY='sk-xxxx'
#   AICHAT_DEEPSEEK_KEY=sk-xxxx      # trailing comments are stripped

# ── LLM Providers (pick one or more) ───────────────────────────────
# Provider used for both question-rewrite (SFT) and response-refine (DPO).
# Default: ollama (local, no key needed).
# AICHAT_AUGMENT_PROVIDER=deepseek

# DeepSeek — https://platform.deepseek.com/api_keys
AICHAT_DEEPSEEK_KEY=
AICHAT_DEEPSEEK_MODEL=deepseek-chat

# 智谱 GLM — https://open.bigmodel.cn/usercenter/apikeys
AICHAT_ZHIPU_KEY=
AICHAT_ZHIPU_MODEL=glm-4-flash

# Moonshot Kimi — https://platform.moonshot.cn/console/api-keys
AICHAT_KIMI_KEY=
AICHAT_KIMI_MODEL=moonshot-v1-8k

# 阿里云百炼 (DashScope) — https://bailian.console.aliyun.com/ → API-KEY
AICHAT_DASHSCOPE_KEY=
AICHAT_DASHSCOPE_MODEL=qwen-max

# OpenAI — https://platform.openai.com/api-keys
AICHAT_OPENAI_KEY=
# AICHAT_AUGMENT_OPENAI_URL=https://api.openai.com/v1

# ── Ollama (local) ─────────────────────────────────────────────────
# Only used when AICHAT_AUGMENT_PROVIDER=ollama (the default).
AICHAT_AUGMENT_OLLAMA_URL=http://localhost:11434/v1
AICHAT_AUGMENT_OLLAMA_MODEL=qwen2.5:7b-instruct

# ── Paths ──────────────────────────────────────────────────────────
# Override default log source / training output directories.
# AICHAT_LOG_DIR=/home/wwk/workspace/ai_project/android-app/logs
# AICHAT_OUTPUT_DIR=/home/wwk/workspace/ai_project/android-app/logs/training

# ── Augmentation switches ──────────────────────────────────────────
# Master switch — set to "1" to enable LLM augmentation.
# AICHAT_AUGMENT_ENABLED=1
